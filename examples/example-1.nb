Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"V2", "[", 
    RowBox[{"h_", ",", "s_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"0.1", " ", 
     RowBox[{"h", "^", "4"}]}], "-", 
    RowBox[{"100", " ", 
     RowBox[{"h", "^", "2"}]}], "+", 
    RowBox[{"0.3", " ", 
     RowBox[{"s", "^", "4"}]}], "-", 
    RowBox[{"60", " ", 
     RowBox[{"s", "^", "2"}]}], "+", 
    RowBox[{"3", " ", 
     RowBox[{"h", "^", "2"}], " ", 
     RowBox[{"s", "^", "2"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Zh", "[", 
    RowBox[{"h_", ",", "s_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "0.01"}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["h", "2"], "+", 
       RowBox[{"2.3", 
        SuperscriptBox["s", "2"]}]}], ")"}]}], "+", "7"}]}], ";"}], "\[IndentingNewLine]", 
